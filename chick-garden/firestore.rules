rules_version = '2';
// 병아리 정원 — Firestore 보안 규칙
// 가족 정원(households/{hid})의 구성원(members)만 그 안의 식물·그룹·기록·사진을 읽고 쓸 수 있습니다.
// 새 구성원은 유효한 초대 코드(invites/{code}, 7일)를 가진 경우에만 자기 자신을 추가할 수 있습니다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function household(hid) { return get(/databases/$(database)/documents/households/$(hid)); }
    function isMember(hid) { return signedIn() && request.auth.uid in household(hid).data.members; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid && isMember(request.resource.data.hid);
      allow delete: if signedIn() && isMember(resource.data.hid);
    }

    match /households/{hid} {
      function joining() {
        let code = request.resource.data.joinCode;
        let inv = get(/databases/$(database)/documents/invites/$(code));
        return inv.data.hid == hid
          && inv.data.expires > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo', 'joinCode'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet());
      }
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (request.auth.uid in resource.data.members || joining());
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /{coll}/{id} {
        allow read, write: if coll in ['plants', 'groups', 'logs', 'photos'] && isMember(hid);
      }
    }
  }
}
